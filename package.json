{
  "name": "dsh-element-source",
  "version": "0.1.0",
  "description": "Click a UI element in the dsh-better-sidebar browser to locate its Vue / React / Svelte / Angular source, then jump to the code in the DSH chat.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "better-sidebar",
    "inspector",
    "vue",
    "react",
    "svelte",
    "angular",
    "source-map",
    "click-to-source"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR-NAME/dsh-element-source"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./vite-plugin": {
      "types": "./vite-plugin/index.d.ts",
      "default": "./lib/vite-plugin.js"
    },
    "./inject.js": "./lib/inject.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "vite-plugin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "scripts/install.sh",
    "scripts/install.ps1"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.build.json && tsdown",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "dsh-better-sidebar": "^0.11.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "cordis": "4.0.0-rc.7",
    "dsh-better-sidebar": "0.11.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
